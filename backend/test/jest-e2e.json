{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^prisma/(.*)$": "<rootDir>/../prisma/$1",
    "^pdfjs-dist/legacy/build/pdf\\.mjs$": "<rootDir>/../src/__mocks__/pdfjs-dist.ts"
  }
}